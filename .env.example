# IFRSmart backend — example environment
# Copy to .env and adjust. NEVER commit a real .env (DEVELOPMENT_RULES.md §6).
# Every value below is a placeholder, not a secret.

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Set to true behind one reverse proxy (Render, a load balancer) so rate limits use the real client address.
TRUST_PROXY=false

# Comma-separated list of exact frontend origins: scheme://host[:port], no path
# and no trailing slash (anything else is rejected at startup). Configured
# origins receive credentialed CORS. "*" allows any origin WITHOUT credentials,
# must be the only entry, and is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (SQLite) ---
# Path is resolved relative to the backend/ directory.
DATABASE_PATH=data/ifrsmart.sqlite
# Set to "true" to allow :memory: (used by the test suite).
# Boolean settings accept true | false | 1 | 0; when absent they are false.
DATABASE_ALLOW_MEMORY=false

# --- Sessions ---
# Lifetime of an authenticated session, in seconds.
SESSION_TTL_SECONDS=86400
# Optional: pin sessions to one IP. Default false (breaks mobile/laptop networks).
SESSION_BIND_IP=false

# --- Security ---
# Minimum accepted password length.
PASSWORD_MIN_LENGTH=8
# Passwords are hashed with scrypt (node:crypto). Defaults are the OWASP
# minimum: N=2^17, r=8, p=1, which needs 128 MiB per hash, so SCRYPT_MAXMEM
# must exceed 128 * SCRYPT_COST * SCRYPT_BLOCK_SIZE. SCRYPT_COST must be a
# power of two. Each stored hash records its own parameters, so raising the
# cost later does not invalidate existing passwords.
SCRYPT_COST=131072
SCRYPT_BLOCK_SIZE=8
SCRYPT_PARALLELIZATION=1
SCRYPT_MAXMEM=268435456

# --- Uploads (local storage driver) ---
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# 10 MB, per the approved architecture.
UPLOAD_MAX_BYTES=10485760

# --- Logging ---
# fatal | error | warn | info | debug | silent
LOG_LEVEL=info

# --- AI (OPTIONAL) ---
# The product is fully functional with NO provider configured (AI_CONTEXT.md).
# Deterministic capabilities (categorization, anomalies, forecast, insights, health)
# always run locally. Leave AI_PROVIDER empty to run in deterministic-only mode.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Per-company daily cap on external provider calls (demo cost control).
AI_DAILY_CALL_CAP_PER_COMPANY=50
